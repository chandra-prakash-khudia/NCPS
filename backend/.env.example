# Copy to backend/.env and fill in values
# Local Postgres:
# NCPS_WEBAPP_DATABASE_URL=postgresql+psycopg2://USER@localhost:5432/ncps
# Render Postgres (External URL from dashboard — for laptop migrations):
# NCPS_WEBAPP_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST.oregon-postgres.render.com/ncps
NCPS_WEBAPP_DATABASE_URL=
NCPS_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NCPS_AUTH_SECRET=change-me-in-production
# Local sklearn C_ML + Anom_ML (train: PYTHONPATH=. python scripts/train_ml_models.py)
NCPS_LOCAL_ML_ENABLED=true
# NCPS_ML_MODELS_DIR=backend/models/trained
