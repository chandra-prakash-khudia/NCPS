   DEBUG: 2026-06-01 02:19:57,583:      pdf_renderer.py:  470: printSegment: alpha
   DEBUG: 2026-06-01 02:19:57,583:      pdf_renderer.py:  470: printSegment: _
   DEBUG: 2026-06-01 02:19:57,584:      pdf_renderer.py:  470: printSegment: {ml} - 
   DEBUG: 2026-06-01 02:19:57,584:      pdf_renderer.py:  470: printSegment: \
   DEBUG: 2026-06-01 02:19:57,584:      pdf_renderer.py:  470: printSegment: gamma
   DEBUG: 2026-06-01 02:19:57,585:      pdf_renderer.py:  470: printSegment: _
   DEBUG: 2026-06-01 02:19:57,585:      pdf_renderer.py:  470: printSegment: {mem}) 
   DEBUG: 2026-06-01 02:19:57,585:      pdf_renderer.py:  470: printSegment: \
   DEBUG: 2026-06-01 02:19:57,586:      pdf_renderer.py:  470: printSegment: cdot C
   DEBUG: 2026-06-01 02:19:57,586:      pdf_renderer.py:  470: printSegment: _
   DEBUG: 2026-06-01 02:19:57,587:      pdf_renderer.py:  470: printSegment: {Bayes} + 
   DEBUG: 2026-06-01 02:19:57,587:      pdf_renderer.py:  470: printSegment: \
   DEBUG: 2026-06-01 02:19:57,587:      pdf_renderer.py:  470: printSegment: alpha
   DEBUG: 2026-06-01 02:19:57,588:      pdf_renderer.py:  470: printSegment: _
   DEBUG: 2026-06-01 02:19:57,588:      pdf_renderer.py:  470: printSegment: {ml} 
   DEBUG: 2026-06-01 02:19:57,588:      pdf_renderer.py:  470: printSegment: \
   DEBUG: 2026-06-01 02:19:57,589:      pdf_renderer.py:  470: printSegment: cdot C
   DEBUG: 2026-06-01 02:19:57,589:      pdf_renderer.py:  470: printSegment: _
   DEBUG: 2026-06-01 02:19:57,589:      pdf_renderer.py:  470: printSegment: {ML} + 
   DEBUG: 2026-06-01 02:19:57,590:      pdf_renderer.py:  470: printSegment: \
