   DEBUG: 2026-06-01 02:19:57,591:      pdf_renderer.py:  470: printSegment: _
   DEBUG: 2026-06-01 02:19:57,591:      pdf_renderer.py:  470: printSegment: {mem} 
   DEBUG: 2026-06-01 02:19:57,591:      pdf_renderer.py:  470: printSegment: \
   DEBUG: 2026-06-01 02:19:57,592:      pdf_renderer.py:  470: printSegment: cdot C
